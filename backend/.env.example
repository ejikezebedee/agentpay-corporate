# AgentPay MVP backend environment template
# Use real values only in your deployment provider's secret manager.

NODE_ENV=production
APP_URL=https://agentpay.example
API_URL=https://api.agentpay.example

DATABASE_URL=postgresql://agentpay_user:change_me@db-host:5432/agentpay
REDIS_URL=redis://redis-host:6379

JWT_SECRET=replace_with_64_character_random_secret
SESSION_COOKIE_NAME=agentpay_session

BINANCE_PAY_API_KEY=replace_in_secret_manager
BINANCE_PAY_SECRET_KEY=replace_in_secret_manager
BINANCE_PAY_CERT_SN=replace_in_secret_manager
BINANCE_PAY_WEBHOOK_PUBLIC_KEY=replace_in_secret_manager

S3_ENDPOINT=https://s3-compatible-provider.example
S3_BUCKET=agentpay-deliveries
S3_ACCESS_KEY=replace_in_secret_manager
S3_SECRET_KEY=replace_in_secret_manager

EMAIL_PROVIDER=resend
EMAIL_FROM=no-reply@agentpay.example
EMAIL_API_KEY=replace_in_secret_manager

SENTRY_DSN=
