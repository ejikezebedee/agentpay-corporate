PORT=3000
NODE_ENV=production
AGENTPAY_API_KEY_ID=replace-with-agent-key-id
AGENTPAY_API_KEY_SECRET=replace-with-long-random-agent-secret
BINANCE_PAY_WEBHOOK_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nreplace-with-binance-pay-webhook-public-key\n-----END PUBLIC KEY-----"
DATABASE_URL=postgres://agentpay:replace-password@postgres:5432/agentpay
MONGODB_URL=mongodb://mongo:27017/agentpay
MONGODB_LISTINGS_COLLECTION=listings
REDIS_URL=redis://redis:6379
AUDIT_LOG_LEVEL=info
