PORT=3000
NODE_ENV=development
AGENTPAY_API_KEY_ID=demo-agent
AGENTPAY_API_KEY_SECRET=replace-with-generated-api-secret
AGENTPAY_ADMIN_EMAIL=admin@zebepay.test
AGENTPAY_ADMIN_PASSWORD=replace-with-strong-admin-password
AGENTPAY_ADMIN_TOKEN_SECRET=replace-with-generated-admin-token-secret
AGENTPAY_SESSION_TOKEN_SECRET=replace-with-generated-session-token-secret
BINANCE_PAY_WEBHOOK_PUBLIC_KEY_PEM="-----BEGIN PUBLIC KEY-----\nreplace-with-binance-pay-webhook-public-key\n-----END PUBLIC KEY-----"
DATABASE_URL=postgres://agentpay:replace-password@localhost:5432/agentpay
MONGODB_URL=mongodb://localhost:27017/agentpay
MONGODB_LISTINGS_COLLECTION=listings
AUDIT_LOG_LEVEL=info
